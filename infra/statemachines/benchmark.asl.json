{
  "Comment": "Manual EC2 Spot benchmark campaign. Run one c6a.large Spot instance per policy and attempt, verify termination and volume deletion, then consolidate published results.",
  "StartAt": "Plan",
  "States": {
    "Plan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ControlFunction}",
        "Payload": {
          "action": "plan_campaign",
          "request.$": "$.request",
          "require_spot": true,
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": {
        "plan.$": "$.Payload"
      },
      "ResultPath": "$.planned",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PreflightFailed"
        }
      ],
      "Next": "EnsureEndpoints"
    },
    "PreflightFailed": {
      "Type": "Fail",
      "Error": "PreflightFailed",
      "Cause": "Request, release, snapshot or plan validation failed. No instance was submitted."
    },
    "EnsureEndpoints": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EndpointsFunction}",
        "Payload": {
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "EndpointsPending"
          ],
          "IntervalSeconds": 15,
          "MaxAttempts": 60,
          "BackoffRate": 1
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EndpointSetupFailed"
        }
      ],
      "Next": "DistributedRuns"
    },
    "EndpointSetupFailed": {
      "Type": "Fail",
      "Error": "EndpointSetupFailed",
      "Cause": "Private interface endpoints could not be provisioned. Check the endpoint stack and lifecycle Lambda logs."
    },
    "DistributedRuns": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket.$": "$.planned.plan.bucket",
          "Key.$": "$.planned.plan.items_key"
        }
      },
      "MaxConcurrencyPath": "$.planned.plan.concurrency",
      "ToleratedFailurePercentage": 100,
      "ItemSelector": {
        "item.$": "$$.Map.Item.Value",
        "control.$": "$.planned.plan.control_function",
        "execution_arn.$": "$$.Execution.Id"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "ReconcileSpotAttempt",
        "States": {
          "ReconcileSpotAttempt": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "advance_spot_run",
                "item.$": "$.item",
                "execution_arn.$": "$.execution_arn"
              }
            },
            "ResultSelector": {
              "state.$": "$.Payload"
            },
            "ResultPath": "$.spot",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "SpotControllerFailed"
              }
            ],
            "Next": "SpotAttemptTerminal"
          },
          "SpotAttemptTerminal": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.spot.state.terminal",
                "BooleanEquals": true,
                "Next": "SpotAttemptResult"
              }
            ],
            "Default": "WaitForSpotAttempt"
          },
          "WaitForSpotAttempt": {
            "Type": "Wait",
            "SecondsPath": "$.spot.state.wait_seconds",
            "Next": "ReconcileSpotAttempt"
          },
          "SpotAttemptResult": {
            "Type": "Pass",
            "InputPath": "$.spot.state",
            "End": true
          },
          "SpotControllerFailed": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "CONTROL_FAILED",
              "reason.$": "$.error.Error"
            },
            "End": true
          }
        }
      },
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "${MapResultsBucket}",
          "Prefix.$": "States.Format('map-results/{}', $.planned.plan.campaign_id)"
        }
      },
      "ResultPath": "$.results",
      "Next": "InitVerification",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.map_error",
          "Next": "RecoverMapError"
        }
      ]
    },
    "RecoverMapError": {
      "Type": "Pass",
      "Result": [],
      "ResultPath": "$.results",
      "Next": "InitVerification"
    },
    "InitVerification": {
      "Type": "Pass",
      "Result": 0,
      "ResultPath": "$.verification_checks",
      "Next": "VerifyNoActiveInstances"
    },
    "VerifyNoActiveInstances": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.planned.plan.control_function",
        "Payload": {
          "action": "reconcile_campaign",
          "campaign_id.$": "$.planned.plan.campaign_id",
          "reason": "post-campaign verification",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": {
        "clean.$": "$.Payload.clean",
        "active_instances.$": "$.Payload.active_instances",
        "remaining_volumes.$": "$.Payload.remaining_volumes"
      },
      "ResultPath": "$.reconciliation",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "InstancesTerminated"
    },
    "InstancesTerminated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.reconciliation.clean",
          "BooleanEquals": true,
          "Next": "Consolidate"
        },
        {
          "Variable": "$.verification_checks",
          "NumericGreaterThanEquals": 10,
          "Next": "CleanupIncomplete"
        }
      ],
      "Default": "WaitForTermination"
    },
    "WaitForTermination": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CountVerification"
    },
    "CountVerification": {
      "Type": "Pass",
      "Parameters": {
        "value.$": "States.MathAdd($.verification_checks, 1)"
      },
      "ResultPath": "$.verification_increment",
      "Next": "ApplyVerificationCount"
    },
    "ApplyVerificationCount": {
      "Type": "Pass",
      "InputPath": "$.verification_increment.value",
      "ResultPath": "$.verification_checks",
      "Next": "VerifyNoActiveInstances"
    },
    "CleanupIncomplete": {
      "Type": "Fail",
      "Error": "CleanupIncomplete",
      "Cause": "EC2 instances or temporary volumes remain. See campaigns/<id>/reconciliation/."
    },
    "Consolidate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.planned.plan.control_function",
        "Payload": {
          "action": "consolidate",
          "campaign_id.$": "$.planned.plan.campaign_id",
          "results.$": "$.results"
        }
      },
      "ResultSelector": {
        "complete.$": "$.Payload.complete",
        "succeeded.$": "$.Payload.succeeded",
        "total.$": "$.Payload.total",
        "summary_uri.$": "$.Payload.summary_uri"
      },
      "ResultPath": "$.summary",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "CampaignResult"
    },
    "CampaignResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.summary.complete",
          "BooleanEquals": true,
          "Next": "CampaignSucceeded"
        }
      ],
      "Default": "CampaignIncomplete"
    },
    "CampaignSucceeded": {
      "Type": "Succeed"
    },
    "CampaignIncomplete": {
      "Type": "Fail",
      "Error": "CampaignIncomplete",
      "Cause": "At least one benchmark failed, was cancelled or did not finish publication. See campaigns/<id>/summary.json."
    }
  }
}
