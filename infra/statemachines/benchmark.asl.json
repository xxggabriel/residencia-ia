{
  "Comment": "Manual benchmark campaign on AWS Batch with Fargate Spot (serverless). Plan, provision the private interface endpoints, submit every run at once (Batch starts as many tasks as the Fargate Spot vCPU quota allows and queues the rest), reconcile before every submission, retry reclaimed tasks from their S3 checkpoints, consolidate the final manifests and verify that no campaign task is left running. Never triggered by events.",
  "StartAt": "Plan",
  "States": {
    "Plan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ControlFunction}",
        "Payload": {
          "action": "plan_campaign",
          "request.$": "$.request",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": {
        "plan.$": "$.Payload"
      },
      "ResultPath": "$.planned",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PreflightFailed"
        }
      ],
      "Next": "EnsureEndpoints"
    },
    "PreflightFailed": {
      "Type": "Fail",
      "Error": "PreflightFailed",
      "Cause": "Request validation, release resolution, snapshot verification, capacity admission or plan publication failed; no job was submitted."
    },
    "EnsureEndpoints": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EndpointsFunction}",
        "Payload": {
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "EndpointsPending"
          ],
          "IntervalSeconds": 15,
          "MaxAttempts": 60,
          "BackoffRate": 1
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EndpointSetupFailed"
        }
      ],
      "Next": "ChooseFanOut"
    },
    "EndpointSetupFailed": {
      "Type": "Fail",
      "Error": "EndpointSetupFailed",
      "Cause": "Private interface endpoints could not be provisioned. Check the endpoint stack and lifecycle Lambda logs."
    },
    "ChooseFanOut": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.planned.plan.mode",
          "StringEquals": "distributed",
          "Next": "DistributedRuns"
        }
      ],
      "Default": "InlineRuns"
    },
    "InlineRuns": {
      "Type": "Map",
      "ItemsPath": "$.planned.plan.items",
      "MaxConcurrencyPath": "$.planned.plan.concurrency",
      "ItemSelector": {
        "item.$": "$$.Map.Item.Value",
        "control.$": "$.planned.plan.control_function",
        "submission": {
          "failures": 0,
          "wait_seconds": 30,
          "next_job_attempt": 0
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Reconcile",
        "States": {
          "Reconcile": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "reconcile_unit",
                "item.$": "$.item"
              }
            },
            "ResultSelector": {
              "decision.$": "$.Payload.decision",
              "job_id.$": "$.Payload.job_id",
              "details.$": "$.Payload"
            },
            "ResultPath": "$.reconciled",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "UnitFailed"
              }
            ],
            "Next": "Route"
          },
          "Route": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "skip",
                "Next": "Reused"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "wait",
                "Next": "ResetForExistingJob"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "exhausted",
                "Next": "UnitFailed"
              }
            ],
            "Default": "RememberSubmission"
          },
          "Submit": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
              "JobName.$": "$.item.job_name",
              "JobQueue": "${JobQueue}",
              "JobDefinition.$": "$.item.job_definition",
              "Timeout": {
                "AttemptDurationSeconds.$": "$.item.run_timeout_seconds"
              },
              "Parameters": {
                "unit_uri.$": "$.item.unit_uri"
              },
              "ContainerOverrides": {
                "Command.$": "States.Array('continual-bench', 'aws', 'run-unit', '--unit-uri', $.item.unit_uri, '--workdir', '/tmp/cb/run')"
              },
              "Tags": {
                "cb-stack": "${Project}",
                "cb-campaign.$": "$.item.campaign_id",
                "cb-run-id.$": "$.item.run_id"
              },
              "PropagateTags": true
            },
            "TimeoutSecondsPath": "$.item.task_timeout_seconds",
            "ResultSelector": {
              "job_id.$": "$.JobId",
              "status.$": "$.Status"
            },
            "ResultPath": "$.job",
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "RecordFailure"
              }
            ],
            "Next": "RecordSuccess"
          },
          "WaitForExistingJob": {
            "Type": "Wait",
            "Seconds": 60,
            "Next": "DescribeExistingJob"
          },
          "DescribeExistingJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "describe_job",
                "job_id.$": "$.reconciled.job_id"
              }
            },
            "ResultSelector": {
              "terminal.$": "$.Payload.terminal",
              "status.$": "$.Payload.status"
            },
            "ResultPath": "$.existing",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "RecordFailure"
              }
            ],
            "Next": "ExistingJobDone"
          },
          "ExistingJobDone": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.existing.terminal",
                "BooleanEquals": true,
                "Next": "RecordSuccess"
              }
            ],
            "Default": "WaitForExistingJob"
          },
          "RecordSuccess": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "record_attempt",
                "item.$": "$.item"
              }
            },
            "ResultSelector": {
              "status.$": "$.Payload.status",
              "final_uri.$": "$.Payload.final_uri"
            },
            "ResultPath": "$.outcome",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "UnitFailed"
              }
            ],
            "Next": "Published"
          },
          "Published": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.outcome.status",
                "StringEquals": "SUCCEEDED",
                "Next": "UnitSucceeded"
              }
            ],
            "Default": "ResetAfterRecordedJob"
          },
          "RecordFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "record_attempt",
                "item.$": "$.item",
                "error.$": "$.error"
              }
            },
            "ResultPath": null,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "UnitFailed"
              }
            ],
            "Next": "ReconcileSubmissionFailure"
          },
          "Reused": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "REUSED"
            },
            "End": true
          },
          "UnitSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "SUCCEEDED",
              "final_uri.$": "$.outcome.final_uri"
            },
            "End": true
          },
          "UnitFailed": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "FAILED"
            },
            "End": true
          },
          "RememberSubmission": {
            "Type": "Pass",
            "Comment": "Record the next real-job ordinal before submitting; API rejections do not advance it.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt.$": "$.reconciled.details.attempt"
            },
            "ResultPath": "$.submission",
            "Next": "Submit"
          },
          "ResetForExistingJob": {
            "Type": "Pass",
            "ResultPath": "$.submission",
            "Next": "WaitForExistingJob",
            "Comment": "Discard only the prior job ordinal. Preserve the unit-wide no-job count and backoff across real jobs.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt": 0
            }
          },
          "ResetAfterRecordedJob": {
            "Type": "Pass",
            "ResultPath": "$.submission",
            "Next": "Reconcile",
            "Comment": "Discard only the prior job ordinal. Preserve the unit-wide no-job count and backoff across real jobs.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt": 0
            }
          },
          "ReconcileSubmissionFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "reconcile_unit",
                "item.$": "$.item"
              }
            },
            "ResultSelector": {
              "decision.$": "$.Payload.decision",
              "job_id.$": "$.Payload.job_id",
              "details.$": "$.Payload"
            },
            "ResultPath": "$.reconciled",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "UnitFailed"
              }
            ],
            "Next": "RouteSubmissionFailure"
          },
          "RouteSubmissionFailure": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "skip",
                "Next": "Reused"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "wait",
                "Next": "ResetForExistingJob"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "exhausted",
                "Next": "UnitFailed"
              }
            ],
            "Default": "SubmissionMadeProgress"
          },
          "SubmissionMadeProgress": {
            "Type": "Choice",
            "Comment": "A newer Batch job advances the real-job budget while preserving the unit-wide submission-failure budget. An unchanged ordinal consumes only the latter.",
            "Choices": [
              {
                "Variable": "$.reconciled.details.attempt",
                "NumericGreaterThanPath": "$.submission.next_job_attempt",
                "Next": "ResetForRetry"
              }
            ],
            "Default": "CountSubmissionFailure"
          },
          "ResetForRetry": {
            "Type": "Pass",
            "ResultPath": "$.submission",
            "Next": "RememberSubmission",
            "Comment": "Discard only the prior job ordinal. Preserve the unit-wide no-job count and backoff across real jobs.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt": 0
            }
          },
          "CountSubmissionFailure": {
            "Type": "Pass",
            "Parameters": {
              "failures.$": "States.MathAdd($.submission.failures, 1)",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt.$": "$.submission.next_job_attempt"
            },
            "ResultPath": "$.submission",
            "Next": "SubmissionBudgetAvailable"
          },
          "SubmissionBudgetAvailable": {
            "Type": "Choice",
            "Comment": "Five failed submissions without a new job across the entire unit terminate only this unit. Real jobs do not reset this budget; item.max_attempts remains independent.",
            "Choices": [
              {
                "Variable": "$.submission.failures",
                "NumericGreaterThanEquals": 5,
                "Next": "UnitFailed"
              }
            ],
            "Default": "WaitToResubmit"
          },
          "WaitToResubmit": {
            "Type": "Wait",
            "SecondsPath": "$.submission.wait_seconds",
            "Next": "AdvanceSubmissionBackoff"
          },
          "AdvanceSubmissionBackoff": {
            "Type": "Pass",
            "Comment": "The four permitted resubmission delays are 30, 60, 120 and 240 seconds. Reconcile again after waiting to discover late submissions.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "States.MathAdd($.submission.wait_seconds, $.submission.wait_seconds)",
              "next_job_attempt.$": "$.submission.next_job_attempt"
            },
            "ResultPath": "$.submission",
            "Next": "Reconcile"
          }
        }
      },
      "ResultPath": "$.results",
      "Next": "Consolidate"
    },
    "DistributedRuns": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket.$": "$.planned.plan.bucket",
          "Key.$": "$.planned.plan.items_key"
        }
      },
      "MaxConcurrencyPath": "$.planned.plan.concurrency",
      "ToleratedFailurePercentage": 100,
      "ItemSelector": {
        "item.$": "$$.Map.Item.Value",
        "control.$": "$.planned.plan.control_function",
        "submission": {
          "failures": 0,
          "wait_seconds": 30,
          "next_job_attempt": 0
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "DistributedReconcile",
        "States": {
          "DistributedReconcile": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "reconcile_unit",
                "item.$": "$.item"
              }
            },
            "ResultSelector": {
              "decision.$": "$.Payload.decision",
              "job_id.$": "$.Payload.job_id",
              "details.$": "$.Payload"
            },
            "ResultPath": "$.reconciled",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "DistributedUnitFailed"
              }
            ],
            "Next": "DistributedRoute"
          },
          "DistributedRoute": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "skip",
                "Next": "DistributedReused"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "wait",
                "Next": "DistributedResetForExistingJob"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "exhausted",
                "Next": "DistributedUnitFailed"
              }
            ],
            "Default": "DistributedRememberSubmission"
          },
          "DistributedSubmit": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
              "JobName.$": "$.item.job_name",
              "JobQueue": "${JobQueue}",
              "JobDefinition.$": "$.item.job_definition",
              "Timeout": {
                "AttemptDurationSeconds.$": "$.item.run_timeout_seconds"
              },
              "Parameters": {
                "unit_uri.$": "$.item.unit_uri"
              },
              "ContainerOverrides": {
                "Command.$": "States.Array('continual-bench', 'aws', 'run-unit', '--unit-uri', $.item.unit_uri, '--workdir', '/tmp/cb/run')"
              },
              "Tags": {
                "cb-stack": "${Project}",
                "cb-campaign.$": "$.item.campaign_id",
                "cb-run-id.$": "$.item.run_id"
              },
              "PropagateTags": true
            },
            "TimeoutSecondsPath": "$.item.task_timeout_seconds",
            "ResultSelector": {
              "job_id.$": "$.JobId",
              "status.$": "$.Status"
            },
            "ResultPath": "$.job",
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "DistributedRecordFailure"
              }
            ],
            "Next": "DistributedRecordSuccess"
          },
          "DistributedWaitForExistingJob": {
            "Type": "Wait",
            "Seconds": 60,
            "Next": "DistributedDescribeExistingJob"
          },
          "DistributedDescribeExistingJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "describe_job",
                "job_id.$": "$.reconciled.job_id"
              }
            },
            "ResultSelector": {
              "terminal.$": "$.Payload.terminal",
              "status.$": "$.Payload.status"
            },
            "ResultPath": "$.existing",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "DistributedRecordFailure"
              }
            ],
            "Next": "DistributedExistingJobDone"
          },
          "DistributedExistingJobDone": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.existing.terminal",
                "BooleanEquals": true,
                "Next": "DistributedRecordSuccess"
              }
            ],
            "Default": "DistributedWaitForExistingJob"
          },
          "DistributedRecordSuccess": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "record_attempt",
                "item.$": "$.item"
              }
            },
            "ResultSelector": {
              "status.$": "$.Payload.status",
              "final_uri.$": "$.Payload.final_uri"
            },
            "ResultPath": "$.outcome",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "DistributedUnitFailed"
              }
            ],
            "Next": "DistributedPublished"
          },
          "DistributedPublished": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.outcome.status",
                "StringEquals": "SUCCEEDED",
                "Next": "DistributedUnitSucceeded"
              }
            ],
            "Default": "DistributedResetAfterRecordedJob"
          },
          "DistributedRecordFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "record_attempt",
                "item.$": "$.item",
                "error.$": "$.error"
              }
            },
            "ResultPath": null,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "DistributedUnitFailed"
              }
            ],
            "Next": "DistributedReconcileSubmissionFailure"
          },
          "DistributedReused": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "REUSED"
            },
            "End": true
          },
          "DistributedUnitSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "SUCCEEDED",
              "final_uri.$": "$.outcome.final_uri"
            },
            "End": true
          },
          "DistributedUnitFailed": {
            "Type": "Pass",
            "Parameters": {
              "run_id.$": "$.item.run_id",
              "status": "FAILED"
            },
            "End": true
          },
          "DistributedRememberSubmission": {
            "Type": "Pass",
            "Comment": "Record the next real-job ordinal before submitting; API rejections do not advance it.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt.$": "$.reconciled.details.attempt"
            },
            "ResultPath": "$.submission",
            "Next": "DistributedSubmit"
          },
          "DistributedResetForExistingJob": {
            "Type": "Pass",
            "ResultPath": "$.submission",
            "Next": "DistributedWaitForExistingJob",
            "Comment": "Discard only the prior job ordinal. Preserve the unit-wide no-job count and backoff across real jobs.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt": 0
            }
          },
          "DistributedResetAfterRecordedJob": {
            "Type": "Pass",
            "ResultPath": "$.submission",
            "Next": "DistributedReconcile",
            "Comment": "Discard only the prior job ordinal. Preserve the unit-wide no-job count and backoff across real jobs.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt": 0
            }
          },
          "DistributedReconcileSubmissionFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.control",
              "Payload": {
                "action": "reconcile_unit",
                "item.$": "$.item"
              }
            },
            "ResultSelector": {
              "decision.$": "$.Payload.decision",
              "job_id.$": "$.Payload.job_id",
              "details.$": "$.Payload"
            },
            "ResultPath": "$.reconciled",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "DistributedUnitFailed"
              }
            ],
            "Next": "DistributedRouteSubmissionFailure"
          },
          "DistributedRouteSubmissionFailure": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "skip",
                "Next": "DistributedReused"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "wait",
                "Next": "DistributedResetForExistingJob"
              },
              {
                "Variable": "$.reconciled.decision",
                "StringEquals": "exhausted",
                "Next": "DistributedUnitFailed"
              }
            ],
            "Default": "DistributedSubmissionMadeProgress"
          },
          "DistributedSubmissionMadeProgress": {
            "Type": "Choice",
            "Comment": "A newer Batch job advances the real-job budget while preserving the unit-wide submission-failure budget. An unchanged ordinal consumes only the latter.",
            "Choices": [
              {
                "Variable": "$.reconciled.details.attempt",
                "NumericGreaterThanPath": "$.submission.next_job_attempt",
                "Next": "DistributedResetForRetry"
              }
            ],
            "Default": "DistributedCountSubmissionFailure"
          },
          "DistributedResetForRetry": {
            "Type": "Pass",
            "ResultPath": "$.submission",
            "Next": "DistributedRememberSubmission",
            "Comment": "Discard only the prior job ordinal. Preserve the unit-wide no-job count and backoff across real jobs.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt": 0
            }
          },
          "DistributedCountSubmissionFailure": {
            "Type": "Pass",
            "Parameters": {
              "failures.$": "States.MathAdd($.submission.failures, 1)",
              "wait_seconds.$": "$.submission.wait_seconds",
              "next_job_attempt.$": "$.submission.next_job_attempt"
            },
            "ResultPath": "$.submission",
            "Next": "DistributedSubmissionBudgetAvailable"
          },
          "DistributedSubmissionBudgetAvailable": {
            "Type": "Choice",
            "Comment": "Five failed submissions without a new job across the entire unit terminate only this unit. Real jobs do not reset this budget; item.max_attempts remains independent.",
            "Choices": [
              {
                "Variable": "$.submission.failures",
                "NumericGreaterThanEquals": 5,
                "Next": "DistributedUnitFailed"
              }
            ],
            "Default": "DistributedWaitToResubmit"
          },
          "DistributedWaitToResubmit": {
            "Type": "Wait",
            "SecondsPath": "$.submission.wait_seconds",
            "Next": "DistributedAdvanceSubmissionBackoff"
          },
          "DistributedAdvanceSubmissionBackoff": {
            "Type": "Pass",
            "Comment": "The four permitted resubmission delays are 30, 60, 120 and 240 seconds. Reconcile again after waiting to discover late submissions.",
            "Parameters": {
              "failures.$": "$.submission.failures",
              "wait_seconds.$": "States.MathAdd($.submission.wait_seconds, $.submission.wait_seconds)",
              "next_job_attempt.$": "$.submission.next_job_attempt"
            },
            "ResultPath": "$.submission",
            "Next": "DistributedReconcile"
          }
        }
      },
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "${MapResultsBucket}",
          "Prefix.$": "States.Format('map-results/{}', $.planned.plan.campaign_id)"
        }
      },
      "ResultPath": "$.results",
      "Next": "Consolidate"
    },
    "Consolidate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.planned.plan.control_function",
        "Payload": {
          "action": "consolidate",
          "campaign_id.$": "$.planned.plan.campaign_id",
          "results.$": "$.results"
        }
      },
      "ResultSelector": {
        "complete.$": "$.Payload.complete",
        "succeeded.$": "$.Payload.succeeded",
        "total.$": "$.Payload.total",
        "summary_uri.$": "$.Payload.summary_uri"
      },
      "ResultPath": "$.summary",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "InitVerification"
    },
    "InitVerification": {
      "Type": "Pass",
      "Result": 0,
      "ResultPath": "$.verification_checks",
      "Next": "VerifyNoActiveTasks"
    },
    "VerifyNoActiveTasks": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.planned.plan.control_function",
        "Payload": {
          "action": "reconcile_campaign",
          "campaign_id.$": "$.planned.plan.campaign_id",
          "reason": "post-campaign verification"
        }
      },
      "ResultSelector": {
        "clean.$": "$.Payload.clean",
        "active_jobs.$": "$.Payload.active_jobs",
        "running_tasks.$": "$.Payload.running_tasks"
      },
      "ResultPath": "$.reconciliation",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "TasksStopped"
    },
    "TasksStopped": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.reconciliation.clean",
          "BooleanEquals": true,
          "Next": "CampaignResult"
        },
        {
          "Variable": "$.verification_checks",
          "NumericGreaterThanEquals": 10,
          "Next": "TasksStillActive"
        }
      ],
      "Default": "WaitForTermination"
    },
    "WaitForTermination": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CountVerification"
    },
    "CountVerification": {
      "Type": "Pass",
      "Parameters": {
        "value.$": "States.MathAdd($.verification_checks, 1)"
      },
      "ResultPath": "$.verification_increment",
      "Next": "ApplyVerificationCount"
    },
    "ApplyVerificationCount": {
      "Type": "Pass",
      "InputPath": "$.verification_increment.value",
      "ResultPath": "$.verification_checks",
      "Next": "VerifyNoActiveTasks"
    },
    "TasksStillActive": {
      "Type": "Fail",
      "Error": "TasksStillActive",
      "Cause": "Campaign jobs or ECS tasks are still active after reconciliation; inspect campaigns/<id>/reconciliation/."
    },
    "CampaignResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.summary.complete",
          "BooleanEquals": true,
          "Next": "CampaignSucceeded"
        }
      ],
      "Default": "CampaignIncomplete"
    },
    "CampaignSucceeded": {
      "Type": "Succeed"
    },
    "CampaignIncomplete": {
      "Type": "Fail",
      "Error": "CampaignIncomplete",
      "Cause": "At least one run has no final manifest; see campaigns/<id>/summary.json and the run events."
    }
  }
}
