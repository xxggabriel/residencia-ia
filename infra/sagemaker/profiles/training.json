{
  "kind": "training",
  "description": "Fit the Zia social multinomial logistic model on a chronological train split; validation is a later split and the temporal holdout is never read.",
  "image_role": "ml",
  "instance_type": "ml.m5.large",
  "volume_gb": 50,
  "max_runtime_seconds": 14400,
  "train_prefix": "datasets/social/8518bf04c105df75ab72c13bbec1e12b270eb92f/prepared/zia-temporal-v1/",
  "output_prefix": "sagemaker/training/",
  "hyperparameters": {
    "scope": "smoke",
    "max_epochs": "100",
    "patience": "10",
    "min_delta": "0.0001",
    "eval_metric": "validation:log_loss",
    "learning_rate": "0.01",
    "l2_regularization": "0.001",
    "l2": "0.001",
    "validation_fraction": "0.1",
    "seed": "42",
    "restore_best_weights": "true",
    "max_iterations": "100",
    "max_train_rows": "2000000"
  },
  "metric_definitions": [
    {"Name": "train:log_loss", "Regex": "train:log_loss=([0-9.eE+-]+);"},
    {"Name": "train:accuracy", "Regex": "train:accuracy=([0-9.eE+-]+);"},
    {"Name": "validation:log_loss", "Regex": "validation:log_loss=([0-9.eE+-]+);"},
    {"Name": "validation:accuracy", "Regex": "validation:accuracy=([0-9.eE+-]+);"},
    {"Name": "validation:f1_macro", "Regex": "validation:f1_macro=([0-9.eE+-]+);"},
    {"Name": "best_validation_loss", "Regex": "best_validation_loss=([0-9.eE+-]+);"},
    {"Name": "epoch", "Regex": "epoch=([0-9.eE+-]+);"},
    {"Name": "best_epoch", "Regex": "best_epoch=([0-9.eE+-]+);"},
    {"Name": "early_stopped", "Regex": "early_stopped=([0-9.eE+-]+);"},
    {"Name": "patience_consumed", "Regex": "patience_consumed=([0-9.eE+-]+);"},
    {"Name": "training_duration_seconds", "Regex": "training_duration_seconds=([0-9.eE+-]+);"},
    {"Name": "validation_duration_seconds", "Regex": "validation_duration_seconds=([0-9.eE+-]+);"},
    {"Name": "peak_rss_mb", "Regex": "peak_rss_mb=([0-9.eE+-]+);"}
  ]
}
