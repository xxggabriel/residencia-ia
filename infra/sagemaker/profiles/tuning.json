{
  "kind": "tuning",
  "description": "Separate Automatic Model Tuning run over l2 and iterations, minimizing validation log loss on its own chronological validation split.",
  "base": "training",
  "max_runtime_seconds": 14400,
  "objective": {"Type": "Minimize", "MetricName": "validation:log_loss"},
  "max_jobs": 8,
  "max_parallel_jobs": 2,
  "strategy": "Bayesian",
  "ranges": {
    "ContinuousParameterRanges": [{"Name": "l2", "MinValue": "0.00001", "MaxValue": "0.1", "ScalingType": "Logarithmic"}],
    "IntegerParameterRanges": [{"Name": "max_iterations", "MinValue": "8", "MaxValue": "100", "ScalingType": "Linear"}]
  },
  "static_hyperparameters": {
    "scope": "smoke",
    "max_epochs": "100",
    "patience": "10",
    "min_delta": "0.0001",
    "learning_rate": "0.01",
    "validation_fraction": "0.1",
    "seed": "42",
    "restore_best_weights": "true",
    "max_train_rows": "2000000"
  }
}
